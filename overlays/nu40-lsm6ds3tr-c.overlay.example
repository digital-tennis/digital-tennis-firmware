/* REVIEW TEMPLATE, not a verified wiring file. Copy to a reviewed .overlay.
 * ONLY LSM6DS3TR-C (WHO_AM_I=0x6a), not LSM6DS3/TR or LSM6DSO.
 * Example assumptions: SDA=P0.26, SCL=P0.27, SA0=low (I2C 0x6a).
 * Confirm breakout voltage, actual wiring and SA0 before using this file.
 * WHO_AM_I and the I2C address are independent, even when both equal 0x6a. */
&i2c0_default {
 group1 {
  psels = <NRF_PSEL(TWIM_SCL, 0, 27)>, <NRF_PSEL(TWIM_SDA, 0, 26)>;
  /delete-property/ low-power-enable;
 };
};
&i2c0_sleep {
 group1 {
  psels = <NRF_PSEL(TWIM_SCL, 0, 27)>, <NRF_PSEL(TWIM_SDA, 0, 26)>;
  low-power-enable;
 };
};
/ { aliases { external-imu = &tennis_lsm6ds3tr_c; }; };
&i2c0 {
 status = "okay";
 tennis_lsm6ds3tr_c: imu@6a {
  compatible = "st,lsm6ds3tr-c";
  reg = <0x6a>;
  status = "okay";
 };
};
