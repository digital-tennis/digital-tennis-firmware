/ {
    chosen { zephyr,settings-partition = &tennis_bonds; };
    aliases {
        controller-button-1 = &button0;
        controller-button-2 = &button1;
        controller-button-3 = &button2;
        controller-button-4 = &button3;

        racket-serve = &button0;
        racket-forehand = &button1;
        racket-backhand = &button2;
        racket-skill = &button3;
    };
};

/* Separate from the reference wallet storage at 0x174000..0x17cfff.
 * Installation must first verify this reserved code-slot tail is unused/blank.
 * Never erase or mount the reference wallet storage as a Tennis settings volume.
 */
&cpuapp_rram {
    partitions {
        tennis_bonds: partition@168000 {
            compatible = "zephyr,mapped-partition";
            label = "digital-tennis-bonds";
            reg = <0x168000 0x8000>;
        };
    };
};
